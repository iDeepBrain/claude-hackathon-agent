ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=                  # optional, used as fallback if Anthropic fails
REDIS_URL=redis://localhost:6379
MCP_URL=http://localhost:8001/mcp
SESSION_TTL=86400
CACHE_TTL=3600
CACHE_THRESHOLD=0.92

# ─── LLM provider chain ─────────────────────────────────────────────────────
# The agent tries these in order at startup, pinning the first that pings OK.
# Swap providers/models or reorder by editing these values — no code changes.
#
# Primary provider (preferred — usually Claude for hackathon)
LLM_PRIMARY_PROVIDER=anthropic
LLM_PRIMARY_MODEL_HIGH=claude-opus-4-7
LLM_PRIMARY_MODEL_LOW=claude-haiku-4-5-20251001

# Secondary provider (fallback — usually Gemini)
LLM_SECONDARY_PROVIDER=gemini
LLM_SECONDARY_MODEL_HIGH=gemini-2.5-pro
LLM_SECONDARY_MODEL_LOW=gemini-2.5-flash-lite

# Max tokens for each tier
LLM_MAX_TOKENS_HIGH=2048
LLM_MAX_TOKENS_LOW=1024
